# 复制为 .env 并填入你自己的 key(不要把真实 key 提交进 git / 打压缩包)

# AI API 配置 (DeepSeek) — 去 https://platform.deepseek.com 获取
API_KEY=sk-你的deepseek-key
API_BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

# CAS 统一认证配置
CAS_BASE_URL=https://cas.nankai.edu.cn/cas
CAS_SERVICE_URL=http://localhost:3002/api/auth/callback
FRONTEND_URL=http://localhost:5173

# 生产环境必须设置为随机长字符串，否则服务启动即退出（拒绝可伪造的 fallback）
SESSION_SECRET=请改成随机长字符串

# HTTP 临时部署（域名未备案走 IP:8080 阶段）时设为 true，放行登录 cookie
# 上 HTTPS 后删掉这一行，cookie 自动切回 secure
ALLOW_HTTP=false

# 百度 OCR (图片文字识别) — 去 https://console.bce.baidu.com/ai/#/ai/ocr/overview 获取
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
